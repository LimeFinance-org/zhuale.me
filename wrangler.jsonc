{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zhuale-me",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./worker/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/baby*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zhuale-me-db",
      "database_id": "322c4b8c-4495-4702-b8cc-5c740647a1e5",
      "migrations_dir": "./migrations"
    }
  ],
  "routes": [
    { "pattern": "zhuale.me", "custom_domain": true },
    { "pattern": "www.zhuale.me", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
